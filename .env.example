# AstraHealth — local environment
# Copy to .env and adjust as needed. All values below are safe local defaults.

DATABASE_URL=postgresql+psycopg://astra:astra@localhost:5432/astrahealth

JWT_SECRET=astra-local-dev-secret-change-me
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Optional: NASA API key for DONKI space weather. Fixtures are used when empty.
NASA_API_KEY=

# Optional: LLM provider for the AI Flight Surgeon. Rule-based answers when "none".
# One of: none | openai. Refusal and red-flag answers always stay rule-based.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

VITE_API_URL=http://localhost:8000

# Demo mode hides developer-only affordances such as the design-system link.
# Set to false when working on the styleguide.
VITE_DEMO_MODE=true
